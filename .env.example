# Copy this file to examples/.env and fill in your values.
# python-dotenv walks up the directory tree, so a .env here is picked up
# by all example agents when they are started from their own subdirectory.

# Postgres — backs BOTH the A2A PostgresTaskStore (tasks, context
# index, cancel signals) and DBOS Transact's durable workflow state.
# One database, two table prefixes (a2a_* and dbos.*).
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=data_analysis postgres:16
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/Fast_A2A_agents

# Redis (optional) — only used by the result_cache. If unreachable,
# the cache degrades to a no-op and the agent still works.
REDIS_URL=redis://localhost:6379

# Public URL of this service — used in the A2A agent card.
APP_BASE_URL=http://localhost:8000

# Show full exception details in agent failure messages (recommended in dev).
DEBUG=true

# Required for joke_agent and holiday_planne
AZURE_AI_BASE_URL=https://aiplayground-dev.openai.azure.com



