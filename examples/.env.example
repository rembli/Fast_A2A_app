# Copy this file to examples/.env and fill in your values.
# python-dotenv walks up the directory tree, so a .env here is picked up
# by all example agents when they are started from their own subdirectory.

# Azure AI Foundry base URL — required for joke_agent, holiday_planner, image_creator.
# Host only, no path. The agents append /openai/v1 themselves.
AZURE_AI_BASE_URL=https://<resource-name>.services.ai.azure.com

# Deployment name as configured in Azure AI Foundry.
# joke_agent / holiday_planner default to gpt-4o, image_creator to gpt-image-1-mini.
AZURE_AI_DEPLOYMENT_NAME=

# Redis connection (all agents require a running Redis instance).
REDIS_URL=redis://localhost:6379

# Public URL of this service — used in the A2A agent card.
APP_BASE_URL=http://localhost:8000

# Show full exception details in agent failure messages (recommended in dev).
DEBUG=true

# ── secure-agent example only ─────────────────────────────────────────────────
# Where the SqliteTaskStore file lives. Defaults to /data (a mounted volume in
# a container); locally the example falls back to ./data automatically, so you
# can leave this unset.
# DATA_DIR=/data

# Sign-in (OpenID Connect). Leave ALL of these unset to run open (no login).
#
# Microsoft Entra ID (the default — set these three to turn sign-in on):
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
#
# Any other OIDC provider (generic — used only if the ENTRA_* trio is absent):
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://accounts.google.com
# OIDC_SCOPES=openid profile email
#
# Optional for either provider:
# OIDC_REDIRECT_URI=https://<app-host>/auth/callback   # override auto-derived callback
# SESSION_SECRET=                                        # cookie-signing key
